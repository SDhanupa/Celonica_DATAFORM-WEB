# Copy to .env, which is ignored by Git. Use the current private credentials
# for an existing installation; changing these values alone does not rotate
# PostgreSQL roles or Keycloak credentials stored in existing databases.
APP_KEY=
DB_PASSWORD=
KC_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_API_AUDIENCE=ceylonica-api
KEYCLOAK_REALM=celonica-admin
KEYCLOAK_CLIENT_ID=celonica-frontend
KC_HOSTNAME_URL=http://localhost:8081
KC_DB_DATABASE=keycloak_db
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1
TRUSTED_PROXIES=127.0.0.1,::1
# Only needed for a fresh realm import; never use an existing user's password.
KEYCLOAK_INITIAL_USER_PASSWORD=
TEXTWARE_USERNAME=
TEXTWARE_PASSWORD=
TEXTWARE_SENDER_ID=
TEXTWARE_API_URL=https://msg.text-ware.com/send_sms.php
